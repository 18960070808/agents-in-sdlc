---
const target = `${import.meta.env.BASE_URL}pt-br/real-world-development/cli/10-review/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Redirecionando para o resumo e as próximas etapas</title>
  </head>
  <body>
    <a href={target}>Esta lição mudou de endereço. Continue para o resumo e as próximas etapas.</a>
  </body>
</html>
