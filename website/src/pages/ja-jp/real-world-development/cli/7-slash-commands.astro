---
const target = `${import.meta.env.BASE_URL}ja-jp/real-world-development/cli/9-cli-power-tools/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="ja-JP" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Copilot CLI のスラッシュ コマンドにリダイレクトしています</title>
  </head>
  <body>
    <a href={target}>このレッスンは移動しました。Copilot CLI のスラッシュ コマンドのレッスンに進んでください。</a>
  </body>
</html>
