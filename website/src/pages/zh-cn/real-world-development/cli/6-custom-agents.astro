---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/7-qa-agent/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在重定向到质量保障智能体</title>
  </head>
  <body>
    <a href={target}>本课程已迁移，请继续学习质量保障智能体课程。</a>
  </body>
</html>
