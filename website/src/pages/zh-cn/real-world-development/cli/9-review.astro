---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/10-review/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在重定向到总结与后续步骤</title>
  </head>
  <body>
    <a href={target}>本课程已迁移，请继续学习总结与后续步骤课程。</a>
  </body>
</html>
